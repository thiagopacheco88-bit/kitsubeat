{
  "name": "kitsubeat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 7000",
    "dev:turbo": "next dev --turbopack --port 7000",
    "build": "next build",
    "size": "size-limit",
    "analyze": "ANALYZE=true next build",
    "vercel-build": "tsx --tsconfig tsconfig.scripts.json scripts/apply-migrations.ts && next build",
    "start": "next start --port 7000",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:manifest": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed/01-build-manifest.ts",
    "qa:coverage": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed/06-qa-agent.ts",
    "seed:dev": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed/07-dev-seed.ts",
    "pipeline": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed/run-pipeline.ts",
    "generate:lessons": "npx tsx --tsconfig tsconfig.scripts.json scripts/seed/03b-generate-content-sequential.ts",
    "seed:enrich-vocab": "tsx --tsconfig tsconfig.scripts.json scripts/seed/11-enrich-vocab.ts",
    "fetch-images": "tsx --tsconfig tsconfig.scripts.json scripts/seed/19c-fetch-vocab-images.ts",
    "backfill:vocab": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-vocab-identity.ts",
    "audit:geo": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-geo-check.ts",
    "audit:geo:replace": "tsx --tsconfig tsconfig.scripts.json scripts/backfill-geo-check.ts --replace",
    "audit:verse-tokens": "tsx --tsconfig tsconfig.scripts.json scripts/audit/verse-token-distribution.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run src/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "playwright test",
    "test:e2e:a11y": "cross-env RUN_A11Y=1 playwright test a11y.spec.ts",
    "test:qa": "tsx --tsconfig tsconfig.scripts.json scripts/seed/06-qa-agent.ts",
    "test:qa:uuid": "tsx --tsconfig tsconfig.scripts.json scripts/seed/06-qa-uuid-integrity.ts",
    "test:qa:geo": "tsx --tsconfig tsconfig.scripts.json scripts/seed/06-qa-geo-check.ts",
    "test:seed": "tsx tests/support/seed-test-db.ts",
    "test:report": "playwright show-report",
    "test:all": "npm run test:seed && npm run test:unit && npm run test:integration && npm run test:qa && npm run test:e2e",
    "test:measure": "tsx scripts/qa/measure-suite-runtime.ts",
    "test:ci-pr": "npm run test:qa && npm run test:unit && npm run test:integration",
    "test:ci-nightly": "tsx scripts/qa/measure-suite-runtime.ts",
    "test:quarantine": "tsx scripts/qa/run-quarantined.ts",
    "test:qa:enrichment": "tsx --tsconfig tsconfig.scripts.json scripts/seed/12-qa-enrichment.ts",
    "seed:reward-slots": "tsx --tsconfig tsconfig.scripts.json scripts/seed/14-seed-reward-slots.ts",
    "seed:classify-themes": "tsx --tsconfig tsconfig.scripts.json scripts/seed/classify-song-themes.ts",
    "seed:apply-themes": "tsx --tsconfig tsconfig.scripts.json scripts/seed/apply-theme-classifications.ts",
    "audit:starter-picks": "tsx --tsconfig tsconfig.scripts.json scripts/audit/verify-starter-picks.ts",
    "lighthouse:pick-target": "tsx --tsconfig tsconfig.scripts.json scripts/lighthouse-pick-target.ts",
    "lighthouse:baseline": "tsx --tsconfig tsconfig.scripts.json scripts/lighthouse-baseline.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.82.0",
    "@clerk/nextjs": "^7.3.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sentry/nextjs": "^10.52.0",
    "@sglkc/kuromoji": "^1.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@wavesurfer/react": "^1.0.12",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "framer-motion": "^12.38.0",
    "kuroshiro": "^1.2.0",
    "kuroshiro-analyzer-kuromoji": "^1.1.0",
    "next": "^15.5.14",
    "nextjs-toploader": "^3.9.17",
    "p-limit": "^6.2.0",
    "postcss": "^8.5.9",
    "posthog-js": "^1.372.10",
    "posthog-node": "^5.33.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "ts-fsrs": "^5.3.2",
    "wavesurfer.js": "^7.12.5",
    "zod": "^3.24.3",
    "zod-to-json-schema": "^3.24.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/eslintrc": "^3.3.5",
    "@next/bundle-analyzer": "^16.2.4",
    "@playwright/test": "^1.59.1",
    "@size-limit/preset-app": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/youtube": "^0.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "cross-env": "^10.1.0",
    "dotenv": "^16.5.0",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "jsdom": "^29.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "size-limit": "^12.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
