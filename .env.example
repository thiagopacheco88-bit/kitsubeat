# .env.example — copy to .env.local and fill in real values.
# This file is checked into git and documents all required environment variables.
# .env.local is gitignored — never commit real credentials.

# Postgres connection string (Neon serverless Postgres)
DATABASE_URL=postgres://USER:PASSWORD@HOST/kitsubeat?sslmode=require

# Phase 11.5: Admin auth (Clerk). LOCALHOST ONLY — admin routes are not deployed to Vercel.
# Get publishable + secret keys from https://dashboard.clerk.com → API keys
# CLERK_ADMIN_EMAILS = comma-separated list of allowed admin email addresses (case-insensitive).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_EMAILS=thiagopacheco88@gmail.com

# Phase 11.6: Unsplash API key for scripts/seed/19c-fetch-vocab-images.ts (full-catalog imagery)
# Free tier — no credit card. Register at https://unsplash.com/developers, create an app,
# copy the "Access Key" (43-char base64) from the app dashboard.
# Demo tier: 50 requests/hour. Production tier requires a one-time submission with usage screenshot.
UNSPLASH_ACCESS_KEY=
