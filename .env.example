# .env.example — copy to .env.local and fill in real values.
# This file is checked into git and documents all required environment variables.
# .env.local is gitignored — never commit real credentials.

# Postgres connection string (Neon serverless Postgres)
DATABASE_URL=postgres://USER:PASSWORD@HOST/kitsubeat?sslmode=require

# Phase 11.5: Admin auth (Clerk). LOCALHOST ONLY — admin routes are not deployed to Vercel.
# Get publishable + secret keys from https://dashboard.clerk.com → API keys
# CLERK_ADMIN_EMAILS = comma-separated list of allowed admin email addresses (case-insensitive).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ADMIN_EMAILS=thiagopacheco88@gmail.com

# Phase 11.6: Unsplash API key for scripts/seed/19c-fetch-vocab-images.ts (full-catalog imagery)
# Free tier — no credit card. Register at https://unsplash.com/developers, create an app,
# copy the "Access Key" (43-char base64) from the app dashboard.
# Demo tier: 50 requests/hour. Production tier requires a one-time submission with usage screenshot.
UNSPLASH_ACCESS_KEY=

# Phase 15: PostHog analytics (product analytics + GDPR consent)
# Create a free account at https://app.posthog.com → Project Settings → Project API Key
# The token starts with "phc_" and is safe to expose to the browser (NEXT_PUBLIC_ prefix OK).
NEXT_PUBLIC_POSTHOG_TOKEN=
# Use https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud)
# EU cloud may be required for stricter UK-GDPR interpretations — see Phase 17 review.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Phase 15: Sentry error monitoring (client + server + edge)
# Create a free account at https://sentry.io → New Project → JavaScript → Next.js
# The DSN is safe to expose to the browser (NEXT_PUBLIC_ prefix OK for client DSN).
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN — same value as above but without NEXT_PUBLIC_ prefix (server/edge only).
SENTRY_DSN=
# Sentry org slug: https://sentry.io → Settings → Organization → slug field
SENTRY_ORG=
# Sentry project slug: https://sentry.io → Projects → click project → Settings → slug
SENTRY_PROJECT=
# CRITICAL — SENTRY_AUTH_TOKEN is build-time ONLY. NEVER add NEXT_PUBLIC_ prefix.
# Adding NEXT_PUBLIC_ would expose the token in the browser bundle (security incident).
# Vercel: add under Build Environment Variables (NOT Runtime Variables).
# Local: copy to .env.sentry-build-plugin (auto-gitignored; created by Sentry CLI wizard).
# Create at https://sentry.io → Settings → Auth Tokens → New Token
# Required scopes: project:releases + org:read
SENTRY_AUTH_TOKEN=
